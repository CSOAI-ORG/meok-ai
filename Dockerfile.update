# Fast update — base on existing image, just overwrite code
# Avoids re-downloading PyTorch/sentence-transformers (2GB+)
FROM csoai/meok-sovereign:v5-pgvector

WORKDIR /app

# Copy updated code over existing (only code layer changes, deps unchanged)
COPY . /app/meok/

# Ensure directories exist
RUN mkdir -p /app/meok/neural/models /app/logs

EXPOSE 3100

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:3100/health')" || exit 1

CMD ["python", "-m", "meok.mcp.server"]
