# ─────────────────────────────────────────────────────────────────────────────
# MEOK UI — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────
# URL of the MEOK backend API (VPS or Railway.app deployment)
MEOK_BACKEND_URL=http://localhost:8000

# ── Clerk Auth ───────────────────────────────────────────────────────────────
# Get keys from: https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="REPLACE_WITH_NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="REPLACE_WITH_CLERK_SECRET_KEY"
# Webhook secret: Clerk Dashboard → Webhooks → your endpoint → Signing secret
# Required for: user creation sync, GDPR deletion
CLERK_WEBHOOK_SECRET=whsec_REPLACE_WITH_CLERK_WEBHOOK_SECRET

# Clerk redirect URLs (defaults work for most setups)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/birth

# ── Stripe Payments ──────────────────────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com → Developers → API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="REPLACE_WITH_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="REPLACE_WITH_STRIPE_SECRET_KEY"
# Webhook secret: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# Stripe Price IDs (create in Stripe Dashboard → Products → Add product)
# Explorer: Free tier (no Stripe price needed, but reference ID useful)
STRIPE_PRICE_EXPLORER=price_free
# Sovereign: £12/month — unlimited messages, Work OS, Claude Sonnet + GPT-4o
STRIPE_PRICE_SOVEREIGN_MONTHLY=price_REPLACE_WITH_SOVEREIGN_MONTHLY_ID
STRIPE_PRICE_SOVEREIGN_ANNUAL=price_REPLACE_WITH_SOVEREIGN_ANNUAL_ID
# Family: £29/month — up to 5 companions, family dashboard, Guardian alerts
STRIPE_PRICE_FAMILY_MONTHLY=price_REPLACE_WITH_FAMILY_MONTHLY_ID
STRIPE_PRICE_FAMILY_ANNUAL=price_REPLACE_WITH_FAMILY_ANNUAL_ID
# BYOK: £5/month — bring your own API keys
STRIPE_PRICE_BYOK_MONTHLY=price_REPLACE_WITH_BYOK_MONTHLY_ID

# Governance / Labs MCP tiers (create in Stripe Dashboard → Products)
# SMB: £49/month — 1 industry pack, 500 API calls/day, audit logging
STRIPE_PRICE_GOVERNANCE_SMB_MONTHLY=price_REPLACE_WITH_GOVERNANCE_SMB_MONTHLY_ID
# Professional: £149/month — full compliance suite, 12-framework crosswalk, 2000 calls/day
STRIPE_PRICE_GOVERNANCE_PRO_MONTHLY=price_REPLACE_WITH_GOVERNANCE_PRO_MONTHLY_ID
# Enterprise: £499/month — all 208 servers, unlimited calls, SSO, SLA, on-premise
STRIPE_PRICE_GOVERNANCE_ENTERPRISE_MONTHLY=price_REPLACE_WITH_GOVERNANCE_ENTERPRISE_MONTHLY_ID

# ── Email / Waitlist (Loops.so — recommended free tier) ──────────────────────
# Sign up at loops.so → Settings → API Key
# Optional: all fields — waitlist still logs to Vercel function logs without them
LOOPS_API_KEY=
# List ID from Loops.so → Lists → your waitlist list
LOOPS_WAITLIST_LIST_ID=
# Transactional email ID from Loops.so → Transactional → your welcome email
LOOPS_WAITLIST_TRANSACTIONAL_ID=

# ── Email Notifications (Resend — optional) ───────────────────────────────────
# Get from: https://resend.com → API Keys
# If set, sends you an email notification for each waitlist signup
RESEND_API_KEY=
WAITLIST_NOTIFY_EMAIL=nicholastempleman@gmail.com

# ── PostHog Analytics ────────────────────────────────────────────────────────
# Get from: https://posthog.com → new project → Project Settings → API Key
# EU cloud (GDPR compliant — recommended): https://eu.posthog.com
# US cloud: https://us.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_POSTHOG_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ── Sentry Error Tracking ────────────────────────────────────────────────────
# Get DSN from: https://sentry.io → new project → Next.js → DSN
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE@oXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ORG=meok-ai
SENTRY_PROJECT=meok-ui
# Auth token: sentry.io → Settings → Auth Tokens → Create (scope: project:releases)
SENTRY_AUTH_TOKEN=sntrys_REPLACE_WITH_SENTRY_AUTH_TOKEN

# ── AI Model APIs ─────────────────────────────────────────────────────────────
# Server-side only — never exposed to the browser.
# Anthropic: https://console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY="REPLACE_WITH_ANTHROPIC_API_KEY"
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="REPLACE_WITH_OPENAI_API_KEY"
# DeepSeek: https://platform.deepseek.com → API Keys (used for Explorer tier routing)
DEEPSEEK_API_KEY=sk-REPLACE_WITH_DEEPSEEK_API_KEY

# ── SOV3 API (Railway.app — recommended) ─────────────────────────────────────
# Persistent sovereign server. Deploy: railway up (from sovereign-temple/)
# See: /clawd/sovereign-temple/RAILWAY_DEPLOY.md
NEXT_PUBLIC_SOV3_ENDPOINT=https://your-service.up.railway.app
SOV3_API_URL=https://your-service.up.railway.app
SOV3_ADMIN_TOKEN=REPLACE_WITH_SOV3_ADMIN_TOKEN

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://meok.ai
# Set automatically in CI/CD; override manually for local development
NEXT_PUBLIC_APP_VERSION=0.1.0

# Web Push (VAPID) — run `npm run generate-vapid` to create keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_PRIVATE_KEY
VAPID_SUBJECT=mailto:guardian@meok.ai
