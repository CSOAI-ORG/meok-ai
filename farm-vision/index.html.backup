<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>MEOK AI — Farm Vision</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0d0c18;
            color: #fff;
            overflow: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        #camera-container {
            flex: 1;
            position: relative;
            background: #000;
        }
        #camera {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        #capture-canvas { display: none; }

        #ai-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(13,12,24,0.95));
            padding: 20px 16px 120px;
            max-height: 50%;
            overflow-y: auto;
        }
        #ai-response {
            font-size: 15px;
            line-height: 1.5;
            color: #f5f0e8;
        }
        #ai-response .label {
            color: #c9a84c;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        #context-bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(13,12,24,0.85);
            backdrop-filter: blur(10px);
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
        }
        #context-bar .weather { color: #00d4ff; }
        #context-bar .location { color: #c9a84c; }
        #context-bar .time { color: #888; }

        #controls {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(13,12,24,0.95);
            backdrop-filter: blur(20px);
            padding: 16px;
            display: flex;
            justify-content: center;
            gap: 16px;
            align-items: center;
            padding-bottom: max(16px, env(safe-area-inset-bottom));
        }

        .btn {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            border: 2px solid #c9a84c;
            background: rgba(201,168,76,0.1);
            color: #c9a84c;
            font-size: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }
        .btn:active {
            transform: scale(0.9);
            background: rgba(201,168,76,0.3);
        }
        .btn.active {
            background: #c9a84c;
            color: #0d0c18;
        }
        .btn-large {
            width: 72px;
            height: 72px;
            font-size: 28px;
        }

        #status {
            position: absolute;
            top: 60px;
            right: 16px;
            background: rgba(13,12,24,0.8);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        #status .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #22c55e;
        }
        #status.listening .dot { background: #00d4ff; animation: pulse 1s infinite; }
        #status.thinking .dot { background: #a855f7; animation: pulse 0.5s infinite; }
        #status.speaking .dot { background: #c9a84c; animation: pulse 0.3s infinite; }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(201,168,76,0.3);
            border-top-color: #c9a84c;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        #history {
            position: absolute;
            top: 60px;
            left: 0;
            right: 0;
            bottom: 200px;
            overflow-y: auto;
            padding: 16px;
            display: none;
        }
        #history.visible { display: block; }
        .history-item {
            background: rgba(26,25,40,0.8);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 8px;
            font-size: 14px;
        }
        .history-item .time { color: #666; font-size: 10px; }
        .history-item .mode { color: #c9a84c; font-size: 10px; font-weight: 600; }

        #mode-selector {
            position: absolute;
            top: 60px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 6px;
            background: rgba(13,12,24,0.8);
            padding: 6px;
            border-radius: 20px;
            overflow-x: auto;
            max-width: 90%;
        }
        .mode-btn {
            padding: 6px 12px;
            border-radius: 14px;
            font-size: 11px;
            font-weight: 600;
            border: none;
            background: transparent;
            color: #888;
            cursor: pointer;
            white-space: nowrap;
        }
        .mode-btn.active {
            background: #c9a84c;
            color: #0d0c18;
        }
    </style>
</head>
<body>
    <div id="camera-container">
        <video id="camera" autoplay playsinline muted></video>
        <canvas id="capture-canvas"></canvas>

        <div id="context-bar">
            <span class="location">📍 MEOK Farm</span>
            <span class="weather" id="weather">⏳ Loading...</span>
            <span class="time" id="clock">--:--</span>
        </div>

        <div id="mode-selector">
            <button class="mode-btn active" data-mode="general">General</button>
            <button class="mode-btn" data-mode="livestock">Livestock</button>
            <button class="mode-btn" data-mode="crops">Crops</button>
            <button class="mode-btn" data-mode="infrastructure">Infrastructure</button>
            <button class="mode-btn" data-mode="wildlife">Wildlife</button>
        </div>

        <div id="status">
            <span class="dot"></span>
            <span id="status-text">Ready</span>
        </div>

        <div id="ai-overlay">
            <div class="label">🤖 MEOK AI — Farm Vision</div>
            <div id="ai-response">Tap 📸 to capture and analyze. Hold 🎤 to ask questions hands-free.</div>
        </div>

        <div id="history"></div>
    </div>

    <div id="controls">
        <button class="btn" id="btn-history" title="History">📋</button>
        <button class="btn btn-large" id="btn-capture" title="Capture & Analyze">📸</button>
        <button class="btn" id="btn-voice" title="Hold to speak">🎤</button>
    </div>

    <script>
        const API_URL = window.location.origin;
        let currentMode = 'general';
        let isCapturing = false;
        let isListening = false;
        let recognition = null;
        let history = [];

        const video = document.getElementById('camera');
        const canvas = document.getElementById('capture-canvas');
        const ctx = canvas.getContext('2d');
        const aiResponse = document.getElementById('ai-response');
        const status = document.getElementById('status');
        const statusText = document.getElementById('status-text');
        const weatherEl = document.getElementById('weather');
        const clockEl = document.getElementById('clock');
        const historyEl = document.getElementById('history');

        async function initCamera() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: 'environment', width: { ideal: 1920 }, height: { ideal: 1080 } },
                    audio: true
                });
                video.srcObject = stream;
                setStatus('ready', 'Camera ready');
            } catch (err) {
                setStatus('error', 'Camera unavailable');
                aiResponse.innerHTML = '⚠️ Camera access denied. Please allow camera access and reload.';
            }
        }

        function setStatus(state, text) {
            status.className = state;
            statusText.textContent = text;
        }

        function updateClock() {
            const now = new Date();
            clockEl.textContent = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
        }
        setInterval(updateClock, 1000);
        updateClock();

        async function fetchWeather() {
            try {
                const resp = await fetch(`${API_URL}/api/weather`);
                const data = await resp.json();
                if (data.temp_c) {
                    weatherEl.textContent = `${data.temp_c}°C ${data.condition}`;
                }
            } catch {
                weatherEl.textContent = '🌤️ UK Farm';
            }
        }
        fetchWeather();
        setInterval(fetchWeather, 300000);

        async function captureAndAnalyze() {
            if (isCapturing) return;
            isCapturing = true;
            setStatus('thinking', 'Analyzing...');

            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0);
            const imageBase64 = canvas.toDataURL('image/jpeg', 0.7).split(',')[1];

            aiResponse.innerHTML = '<div class="spinner"></div> Analyzing with Qwen3 VL 235B...';

            try {
                const resp = await fetch(`${API_URL}/api/analyze`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        image: imageBase64,
                        mode: currentMode
                    })
                });

                const data = await resp.json();

                if (data.success) {
                    aiResponse.innerHTML = data.analysis.replace(/\n/g, '<br>');
                    setStatus('ready', 'Analysis complete');
                    fetchHistory();
                } else {
                    aiResponse.innerHTML = `⚠️ ${data.error || 'Analysis failed'}`;
                    setStatus('error', 'Failed');
                }
            } catch (err) {
                aiResponse.innerHTML = '⚠️ Connection failed. Check WiFi and try again.';
                setStatus('error', 'Connection failed');
            }

            isCapturing = false;
        }

        async function fetchHistory() {
            try {
                const resp = await fetch(`${API_URL}/api/history`);
                history = await resp.json();
                renderHistory();
            } catch {}
        }

        function renderHistory() {
            historyEl.innerHTML = history.map(item => `
                <div class="history-item">
                    <div class="time">${new Date(item.timestamp).toLocaleTimeString('en-GB')}</div>
                    <div class="mode">${item.mode.toUpperCase()}</div>
                    <div>${item.analysis.substring(0, 150)}...</div>
                </div>
            `).join('');
        }

        function initVoice() {
            if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
                document.getElementById('btn-voice').style.display = 'none';
                return;
            }

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.interimResults = false;
            recognition.lang = 'en-GB';

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                setStatus('thinking', 'Processing...');
                aiResponse.innerHTML = `<div class="spinner"></div> You: "${transcript}"`;
                
                fetch(`${API_URL}/api/voice`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: transcript })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        aiResponse.innerHTML = data.response.replace(/\n/g, '<br>');
                        setStatus('ready', 'Ready');
                    } else {
                        aiResponse.innerHTML = `⚠️ ${data.error}`;
                        setStatus('error', 'Failed');
                    }
                })
                .catch(() => {
                    aiResponse.innerHTML = '⚠️ Response failed.';
                    setStatus('error', 'Failed');
                });
            };

            recognition.onend = () => {
                isListening = false;
                document.getElementById('btn-voice').classList.remove('active');
            };

            const btn = document.getElementById('btn-voice');
            const startListening = (e) => {
                e.preventDefault();
                isListening = true;
                btn.classList.add('active');
                setStatus('listening', 'Listening...');
                recognition.start();
            };
            const stopListening = () => {
                if (isListening) recognition.stop();
            };

            btn.addEventListener('touchstart', startListening);
            btn.addEventListener('touchend', stopListening);
            btn.addEventListener('mousedown', startListening);
            btn.addEventListener('mouseup', stopListening);
        }

        document.querySelectorAll('.mode-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentMode = btn.dataset.mode;
                setStatus('ready', `Mode: ${currentMode}`);
            });
        });

        document.getElementById('btn-capture').addEventListener('click', captureAndAnalyze);
        document.getElementById('btn-capture').addEventListener('touchend', (e) => {
            e.preventDefault();
            captureAndAnalyze();
        });

        document.getElementById('btn-history').addEventListener('click', () => {
            historyEl.classList.toggle('visible');
            if (historyEl.classList.contains('visible')) fetchHistory();
        });

        initCamera();
        initVoice();
        setStatus('ready', 'Farm Vision active');
    </script>
</body>
</html>
