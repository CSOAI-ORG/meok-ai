# MEOK.ai Production Environment
# Copy to .env.prod and fill in values

# Database
MEOK_DB_USER=meok
MEOK_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MEOK_DB_NAME=meok

# Neo4j
MEOK_NEO4J_USER=neo4j
MEOK_NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Auth
MEOK_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
MEOK_AUTH_REQUIRED=true

# API Keys
OPENAI_API_KEY="REPLACE_WITH_OPENAI_API_KEY"
KIMI_API_KEY=

# Docker Images (pushed to registry)
MEOK_DOCKER_IMAGE=meok/sovereign:latest
MEOK_DASHBOARD_IMAGE=meok/dashboard:latest

# Networking
MEOK_PUBLIC_HOST=meok.ai
MEOK_DOMAIN=meok.ai
MEOK_MCP_PORT=3100
MEOK_DASHBOARD_PORT=3000

# Vast.ai Instance
VAST_API_KEY=
VAST_INSTANCE_ID=
