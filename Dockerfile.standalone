# MEOK.ai — Self-Contained Production Image
# Includes: Python 3.11 + PostgreSQL 15 + pgvector
# Ollama installed separately on VPS (GPU drivers available from host)
#
# Build: docker build -f Dockerfile.standalone -t csoai/meok-sovereign:latest .
# Run:   docker run -p 3100:3100 csoai/meok-sovereign:latest

FROM python:3.11-slim-bookworm

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ── System packages + PostgreSQL 15 + pgvector ──────────────────────────────
# python:3.11-slim-bookworm is Debian 12 — use official PGDG repo for PG15 + pgvector
RUN apt-get update && apt-get install -y \
    gnupg curl wget ca-certificates procps \
    gcc g++ make \
    && rm -rf /var/lib/apt/lists/*

# Add PostgreSQL official APT repo (PGDG) for PG15 + pgvector on Debian bookworm
RUN curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
    > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y \
    postgresql-15 \
    postgresql-client-15 \
    postgresql-15-pgvector \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ──────────────────────────────────────────────────────
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Application code ─────────────────────────────────────────────────────────
COPY . /app/meok/

# ── Database schema ───────────────────────────────────────────────────────────
COPY db/init.sql /docker-entrypoint-initdb.d/01_schema.sql

# ── Directories ──────────────────────────────────────────────────────────────
RUN mkdir -p /app/meok/neural/models /logs /tmp/meok_logs

# ── PostgreSQL: configure local auth ─────────────────────────────────────────
# Trust local connections for postgres superuser (needed for DB init)
RUN sed -i "s/^local   all             all                                     peer/local all all trust/" \
    /etc/postgresql/15/main/pg_hba.conf \
    && echo "host meok meok 127.0.0.1/32 md5" >> /etc/postgresql/15/main/pg_hba.conf

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3100

HEALTHCHECK --interval=30s --timeout=10s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:3100/health', timeout=5)" || exit 1

CMD ["/entrypoint.sh"]
