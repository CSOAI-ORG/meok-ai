# MEOK.ai — Development Profile (Nick's personal instance)
# Self-learning enabled, no auth, single-tenant

MEOK_ENVIRONMENT=development
MEOK_DEBUG=true
MEOK_LOG_LEVEL=DEBUG

# Auth disabled for dev
MEOK_AUTH__REQUIRED=false

# Single-tenant mode
MEOK_MULTI_TENANT=false

# Self-learning features enabled
MEOK_HEARTBEAT__ENABLED=true
MEOK_SELF_LEARNING=true

# Database (local Docker)
MEOK_DATABASE__POSTGRES_DSN=postgresql://sovereign:sovereign@localhost:5432/sovereign_memory
MEOK_DATABASE__WEAVIATE_URL=http://localhost:8080
MEOK_DATABASE__NEO4J_URI=bolt://localhost:7687

# MCP Server
MEOK_MCP__HOST=0.0.0.0
MEOK_MCP__PORT=3100
