# MEOK.ai — Production Profile (Public SaaS product)
# Multi-tenant, auth required, self-learning off by default

MEOK_ENVIRONMENT=production
MEOK_DEBUG=false
MEOK_LOG_LEVEL=INFO

# Auth required for all endpoints
MEOK_AUTH__REQUIRED=true
# MEOK_AUTH__JWT_SECRET=  # MUST override in production

# Multi-tenant mode
MEOK_MULTI_TENANT=true

# Self-learning off by default (users can opt in)
MEOK_HEARTBEAT__ENABLED=false
MEOK_SELF_LEARNING=false

# Database (override with production credentials)
# MEOK_DATABASE__POSTGRES_DSN=postgresql://...
# MEOK_DATABASE__WEAVIATE_URL=https://...

# MCP Server
MEOK_MCP__HOST=0.0.0.0
MEOK_MCP__PORT=3100

# CORS locked to meok.ai domain
MEOK_MCP__CORS_ORIGINS=["https://meok.ai","https://www.meok.ai","https://app.meok.ai"]
